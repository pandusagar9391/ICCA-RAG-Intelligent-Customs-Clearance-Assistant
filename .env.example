# ICCA-RAG Environment Variables
# Copy this file to .env and fill in your values if using cloud LLM APIs.
# The system also includes an Offline/Mock mode that works without any API keys!

# LLM Provider: "gemini", "openai", or "offline"
LLM_PROVIDER=offline

# Google Gemini API Key (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API Key (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Retrieval Configuration
SPARSE_TOP_K=5
DENSE_TOP_K=5
BM25_K1=1.5
BM25_B=0.75

# Storage Paths
DATA_DIR=data
STORAGE_DIR=data/storage
